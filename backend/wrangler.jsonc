{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f1-picks-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Observability — auto-indexes structured JSON console.log output
  "observability": {
    "enabled": true,
  },
  // Cloudflare Hyperdrive — connection pooling for Supabase Postgres.
  // Create with: npx wrangler hyperdrive create f1-picks-db --connection-string="<SUPABASE_DIRECT_URL>"
  // Then paste the ID below.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // For `wrangler dev`, set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in
      // backend/.dev.vars (gitignored). Never commit a connection string here.
      "id": "3c3e600e1e6f4ba1a7337c2a432facff",
    },
  ],
}
